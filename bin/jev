#!/bin/sh
# jev: typed decisions for coding agents. Needs Node >= 22.18. Run `jev --help`.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd)
config=${JEV_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/jev/env}

if [ "$1" = setup ]; then
  printf 'Jev API key (TypeSafe apikey_... or OpenRouter sk-or-...): '
  stty -echo 2>/dev/null; read -r key; stty echo 2>/dev/null; echo
  [ -n "$key" ] || { echo "jev setup: no key entered" >&2; exit 1; }
  case $key in sk-or-*) var=OPENROUTER_API_KEY ;; *) var=TYPESAFE_API_KEY ;; esac
  mkdir -p "$(dirname "$config")" && (umask 077 && printf '%s=%s\n' "$var" "$key" > "$config")
  echo "jev setup: saved $var to $config"
  exit 0
fi

# install: copy the package to a stable place (it may run from a clone or from npx's cache),
# put jev on PATH, link the skill where agents look for it, and ask for the key if none is set.
if [ "$1" = install ]; then
  node -e 'const [a, b] = process.versions.node.split(".").map(Number); process.exit(a > 22 || (a === 22 && b >= 18) ? 0 : 1)' 2>/dev/null ||
    { echo "jev needs Node >= 22.18 (found: $(node --version 2>/dev/null || echo none))" >&2; exit 1; }
  dest=${JEV_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/jev}
  if [ "$root" != "$dest" ]; then
    [ ! -e "$dest" ] || [ -x "$dest/bin/jev" ] || { echo "jev install: $dest exists and is not a jev install" >&2; exit 1; }
    rm -rf "$dest.new" && mkdir -p "$dest.new"
    for f in bin src skills AGENTS.snippet.md package.json LICENSE README.md; do cp -R "$root/$f" "$dest.new/"; done
    rm -rf "$dest" && mv "$dest.new" "$dest"
  fi
  echo "jev:   $dest"

  bindir=${JEV_BIN_DIR:-$HOME/.local/bin}
  mkdir -p "$bindir" && ln -sf "$dest/bin/jev" "$bindir/jev"
  echo "cli:   $bindir/jev"
  case ":$PATH:" in *":$bindir:"*) ;; *) echo "       add $bindir to your PATH" ;; esac

  skills=${JEV_SKILLS_DIR:-$HOME/.agents/skills}
  mkdir -p "$skills"
  if [ -e "$skills/jev" ] && [ ! -L "$skills/jev" ]; then
    echo "skill: $skills/jev exists and is not a link, left as is"
  else
    ln -sfn "$dest/skills/jev" "$skills/jev" && echo "skill: $skills/jev"
  fi

  if [ -n "$TYPESAFE_API_KEY$OPENROUTER_API_KEY" ] || [ -f "$config" ]; then
    echo "key:   found"
  else
    "$dest/bin/jev" setup || echo "key:   none yet, run jev setup before the first call"
  fi

  cat <<EOF

Codex and other agents that read ~/.agents/skills now see the jev skill.
Claude Code: install the plugin for the skill, jev on the Bash PATH, and the compaction hook:
  claude plugin marketplace add Duttonn/agentic-jev
  claude plugin install jev@agentic-jev
Any other agent: paste $dest/AGENTS.snippet.md into its instructions file (AGENTS.md, .cursor/rules, ...).
Update: run the install again. Check: jev ask -s hello -q '{"greeting":{"type":"noul","instructions":"Is \`text\` a greeting?"}}'
EOF
  exit 0
fi

[ -f "$config" ] && exec node --env-file="$config" "$root/src/cli.ts" "$@"
exec node "$root/src/cli.ts" "$@"
